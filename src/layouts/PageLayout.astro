---
import '../styles/global.css';
import Header from '../components/Header.astro';
import FooterStatus from '../components/FooterStatus.astro';
import SiteHead from '../components/SiteHead.astro';

interface Props {
  title: string;
  description?: string;
  path?: string;
}

const { title, description, path = Astro.url.pathname } = Astro.props;
---

<html lang="en" data-theme="dark">
  <head>
    <SiteHead title={title} description={description} path={path} />
    <script is:inline>
      const t = localStorage.getItem('freddie-portfolio-theme');
      if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
    </script>
  </head>
  <body>
    <div class="shell">
      <Header navItems={[
        { label: 'ABOUT', href: '/about' },
        { label: 'LABS',  href: '/labs' },
        { label: 'NOTES', href: '/notes' },
      ]} />
      <main>
        <div class="sections">
          <slot />
        </div>
      </main>
      <FooterStatus />
    </div>
  </body>
</html>

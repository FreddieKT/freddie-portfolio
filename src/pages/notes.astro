---
import PageLayout from '../layouts/PageLayout.astro';
import { projects } from '../data/projects';
---

<PageLayout title="Notes" description="Short write-ups on things I've learned.">
  <section class="editorial-section" data-animate="page-section">
    <span class="label">Notes</span>
    <div class="section-content">
      <p class="copy">Short write-ups on things I've learned: AI workflows, terminal tools, frontend tricks, and whatever else sticks after the tabs are closed.</p>
    </div>
  </section>
</PageLayout>

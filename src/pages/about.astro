---
import { Image } from 'astro:assets';
import profileImage from '../assets/images/profile-about.jpg';
import PageLayout from '../layouts/PageLayout.astro';

const stack = [
  'Astro', 'TypeScript', 'Python',
  'AI / LLMs', 'GSAP', 'Terminal UX', 'Systems Design',
];
---

<PageLayout title="About" description="Khant Thura Thaung, also known as Freddie, builds small AI tools, automation workflows, and terminal-native experiments.">
  <section class="editorial-section" data-animate="page-section">
    <span class="label">Identity</span>
    <div class="section-content">
      <figure class="photo-frame">
        <Image src={profileImage} alt="Khant Thura Thaung" width={176} height={235} loading="eager" decoding="async" />
      </figure>
      <div class="identity-text">
        <p class="identity-name">FREDDIE K.</p>
        <p class="label">BUILDER @ Freddie K.</p>
        <p class="copy" style="margin-top:0.75rem">I'm Khant Thura Thaung, but online I usually go by Freddie. I build small AI tools, automation workflows, and strange little systems for problems I keep running into.</p>
      </div>
    </div>
  </section>

  <section class="editorial-section" data-animate="page-section">
    <span class="label">Stack</span>
    <div class="section-content">
      <div class="stack-tags">
        {stack.map((tool) => (<span class="stack-tag">{tool}</span>))}
      </div>
    </div>
  </section>

  <section class="editorial-section" data-animate="page-section">
    <span class="label">Approach</span>
    <div class="section-content">
      <p class="copy">Build small. Ship fast. Keep what's useful.</p>
      <p class="copy" style="margin-top:0.75rem">Most of my projects start from an annoyance: too many notes, messy decisions, repeated manual work, or systems that forget what happened yesterday.</p>
      <p class="copy" style="margin-top:0.75rem">I do not like bloated tools. I like prototypes that survive real use, explain themselves quickly, and stay small until they earn the right to grow.</p>
    </div>
  </section>

  <section class="editorial-section" data-animate="page-section">
    <span class="label">Links</span>
    <div class="section-content">
      <ul class="links-list">
        <li><a class="link-row" href="https://github.com/FreddieKT" target="_blank" rel="noreferrer"><span class="link-label">GITHUB</span><span class="link-value">FreddieKT</span><span class="link-arrow">↗</span></a></li>
        <li><a class="link-row" href="https://x.com/ktythaung" target="_blank" rel="noreferrer"><span class="link-label">X</span><span class="link-value">@ktythaung</span><span class="link-arrow">↗</span></a></li>
        <li><a class="link-row" href="mailto:ktythaung@gmail.com"><span class="link-label">EMAIL</span><span class="link-value">ktythaung@gmail.com</span><span class="link-arrow">→</span></a></li>
      </ul>
    </div>
  </section>
</PageLayout>

<style>
  .photo-frame {
    flex: 0 0 auto;
    width: 9.5rem;
    aspect-ratio: 3 / 4;
    margin: 0 0 1rem 0;
  }
  .photo-frame img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 0%; border-radius: 4px; }
  .identity-text { min-width: 0; }
  .identity-name { margin: 0; font-size: clamp(1.4rem, 2.5vw, 2rem); font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; line-height: 1; }
  .stack-tags { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .stack-tag { display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.4rem 0.85rem; border: 1px solid var(--rule-soft); font-size: 0.75rem; color: var(--ink-dim); letter-spacing: 0.08em; border-radius: 999px; }
  .links-list { list-style: none; margin: 0; padding: 0; }
  .link-row { display: flex; align-items: center; gap: 0.75rem; padding: 0.85rem 0; border-bottom: 1px solid var(--rule-soft); transition: color 160ms ease; }
  .link-row:last-child { border-bottom: none; }
  .link-row:hover { color: var(--accent); }
  .link-label { font-size: 0.75rem; color: var(--ink-dim); letter-spacing: 0.12em; min-width: 5rem; }
  .link-value { font-size: 0.875rem; color: var(--ink-soft); flex: 1; }
  .link-arrow { color: var(--accent); margin-left: auto; }
</style>

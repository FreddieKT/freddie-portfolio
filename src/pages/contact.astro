---
import PageLayout from '../layouts/PageLayout.astro';
---

<PageLayout title="Contact" description="Say hi — I'm always happy to chat about tools, automation, or whatever you're building.">
  <section class="editorial-section" data-animate="page-section">
    <span class="label">Contact</span>
    <div class="section-content">
      <p class="copy">I build tools, tinker with AI, and occasionally ship things that work. Here's where to find me.</p>
    </div>
  </section>

  <section class="editorial-section" data-animate="page-section">
    <span class="label">Reach out</span>
    <div class="section-content">
      <ul class="links-list">
        <li><a class="link-row" href="https://github.com/FreddieKT" target="_blank" rel="noreferrer"><span class="link-label">GITHUB</span><span class="link-value">FreddieKT</span><span class="link-arrow">&#8599;</span></a></li>
        <li><a class="link-row" href="https://x.com/ktythaung" target="_blank" rel="noreferrer"><span class="link-label">X</span><span class="link-value">@ktythaung</span><span class="link-arrow">&#8599;</span></a></li>
        <li><a class="link-row" href="mailto:ktythaung@gmail.com"><span class="link-label">EMAIL</span><span class="link-value">ktythaung@gmail.com</span><span class="link-arrow">&#8594;</span></a></li>
      </ul>
    </div>
  </section>
</PageLayout>

<style>
  .links-list { list-style: none; margin: 0; padding: 0; }
  .link-row { display: flex; align-items: center; gap: 0.75rem; padding: 0.85rem 0; border-bottom: 1px solid var(--rule-soft); transition: color 160ms ease; }
  .link-row:last-child { border-bottom: none; }
  .link-row:hover { color: var(--accent); }
  .link-label { font-size: 0.75rem; color: var(--ink-dim); letter-spacing: 0.12em; min-width: 5rem; }
  .link-value { font-size: 0.875rem; color: var(--ink-soft); flex: 1; }
  .link-arrow { color: var(--accent); margin-left: auto; }
</style>

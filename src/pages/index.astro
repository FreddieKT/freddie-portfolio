---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import FooterStatus from '../components/FooterStatus.astro';
import SiteHead from '../components/SiteHead.astro';
import { projects } from '../data/projects';
---

<html lang="en" data-theme="dark">
  <head>
    <SiteHead />
    <script is:inline>
      const t = localStorage.getItem('freddie-portfolio-theme');
      if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
    </script>
  </head>
  <body>
    <div class="shell">
      <main>
        <Header navItems={[
          { label: 'ABOUT', href: '/about' },
          { label: 'LABS',  href: '/labs' },
          { label: 'NOTES', href: '/notes' },
        ]} />

        <Hero />

        <section id="about" class="editorial-section" aria-label="About">
          <span class="label">About</span>
          <div class="section-content">
            <p class="copy">I'm Khant (Freddie). I like building things that solve real problems — mostly because I got tired of doing the same thing twice. This site is a loose collection of tools, experiments, and notes from the stuff I've been working on.</p>
            <a class="pointer" href="/about" style="margin-top:1rem">More about me →</a>
          </div>
        </section>

        <section id="notes" class="editorial-section" aria-label="Notes">
          <span class="label">Notes</span>
          <div class="section-content">
            <p class="copy">Short write-ups on things I've learned: AI workflows, terminal tools, frontend tricks, and whatever else sticks after the tabs are closed.</p>
            <a class="pointer" href="/notes" style="margin-top:1rem">Read notes →</a>
          </div>
        </section>

        <section id="work" class="editorial-section" aria-label="Projects and experiments">
          <span class="label">Projects &amp; Experiments</span>
          <div class="section-content">
            <ul class="plist" aria-label="Projects">
              {projects.map((p) => <ProjectCard project={p} />)}
            </ul>
            <a class="pointer" href="/labs" style="margin-top:1rem">Browse labs →</a>
          </div>
        </section>
      </main>

      <FooterStatus />
    </div>

    <script>
      import { gsap } from 'gsap';
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!reduceMotion) {
        const els = document.querySelectorAll('.hero, .editorial-section, .prow, .hd');
        gsap.set(els, { autoAlpha: 0, y: 16 });
        gsap.to(els, {
          autoAlpha: 1, y: 0, duration: 0.5, ease: 'power2.out',
          stagger: { amount: 0.25, from: 'start' },
        });
      }
    </script>
  </body>
</html>

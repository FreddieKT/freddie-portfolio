---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SectionLabel from '../components/SectionLabel.astro';
import FooterStatus from '../components/FooterStatus.astro';
import { projects } from '../data/projects';
import { getCollection } from 'astro:content';

const allNotes = await getCollection('notes');
const latestNotes = allNotes
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3)
  .map((note) => ({
    ...note,
    slug: note.id.replace(/\.md$/, ''),
  }));

const featuredLabs = projects.slice(0, 3);

const aboutSignals = [
  { label: 'Automation', copy: 'workflows that remove repeated manual steps' },
  { label: 'Memory', copy: 'systems that keep context from disappearing' },
  { label: 'Interfaces', copy: 'terminal-inspired UI experiments with a practical edge' },
];
---

<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>FREDDIE K. — Strange tools for real life</title>
    <meta
      name="description"
      content="FREDDIE K. is Freddie's portfolio for small AI tools, automation workflows, memory systems, and terminal-native experiments."
    />
    
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" type="image/png" href="/favicon.png" />
    
    <!-- Open Graph / Social Media -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content="FREDDIE K. — Strange tools for real life" />
    <meta property="og:description" content="FREDDIE K. is Freddie's portfolio for small AI tools, automation workflows, memory systems, and terminal-native experiments." />
    <meta property="og:image" content="/favicon.png" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="FREDDIE K. — Strange tools for real life" />
    <meta name="twitter:description" content="FREDDIE K. is Freddie's portfolio for small AI tools, automation workflows, memory systems, and terminal-native experiments." />
  </head>
  <body>
    <main id="top" class="page-shell">
      <section class="frame hero-frame" aria-label="FREDDIE K. portfolio introduction">
        <Header />

        <div class="hero-grid">
          <Hero />
        </div>
      </section>

      <section class="content-stack" aria-label="FREDDIE K. portfolio sections">
        <section id="about" class="section-panel frame" aria-labelledby="about-title" data-animate="section-panel">
          <SectionLabel id="about-title">About</SectionLabel>
          <p class="mono-copy">
            I turn messy workflows into small tools I can actually use: memory, decisions,
            creative experiments, and automation that does not need a meeting to explain.
          </p>
          <div class="mini-preview-grid" aria-label="About focus areas">
            {aboutSignals.map((item) => (
              <article class="mini-preview-card">
                <strong>{item.label}</strong>
                <span>{item.copy}</span>
              </article>
            ))}
          </div>
        </section>

        <section id="labs" class="section-panel frame" aria-labelledby="labs-title" data-animate="section-panel">
          <SectionLabel id="labs-title">Labs</SectionLabel>
          <p class="mono-copy">
            A workbench for AI agents, prompt tooling, terminal UX, and visual systems. Some ideas
            grow into tools. Some stay as sketches. Both are useful.
          </p>
          <div class="mini-preview-grid" aria-label="Featured labs">
            {featuredLabs.map((project) => (
              <a class="mini-preview-card mini-preview-link" href={`/labs/${project.slug}`}>
                <strong>{project.title}</strong>
                <span>{project.summary}</span>
              </a>
            ))}
          </div>
        </section>

        <section id="notes" class="section-panel frame" aria-labelledby="notes-title" data-animate="section-panel">
          <SectionLabel id="notes-title">Notes</SectionLabel>
          <p class="mono-copy">
            Notes on AI tools, frontend systems, terminal UX, and the parts of building that are
            worth remembering after the tab is closed.
          </p>
          <div class="mini-preview-grid" aria-label="Latest notes">
            {latestNotes.map((note) => (
              <a class="mini-preview-card mini-preview-link" href={`/notes/${note.slug}`}>
                <strong>{note.data.title}</strong>
                <span>{note.data.summary}</span>
              </a>
            ))}
          </div>
        </section>

        <section id="work" aria-label="Work and prototype projects" data-animate="work-section">
          <div class="project-grid" aria-label="Projects">
            {projects.map((project) => <ProjectCard project={project} />)}
          </div>
        </section>
      </section>

      <FooterStatus />
    </main>

    <script>
      import { gsap } from 'gsap';

      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (!reduceMotion) {
        // Hero sub-elements
        gsap.set('[data-animate="hero-portrait"]', { autoAlpha: 0, scale: 0.96, y: 10 });
        gsap.set('[data-animate="hero-eyebrow"]', { autoAlpha: 0, y: 10 });
        gsap.set('[data-animate="hero-heading"]', { autoAlpha: 0, y: 18 });
        gsap.set('[data-animate="hero-subhead"]', { autoAlpha: 0, y: 14 });
        gsap.set('[data-animate="hero-tag"]', { autoAlpha: 0, x: -10 });

        gsap.set('[data-animate="section-panel"], [data-animate="project-card"], [data-animate="metrics-strip"], [data-animate="metric-cell"]', {
          autoAlpha: 0,
          y: 18,
        });

        const heroTl = gsap.timeline({ defaults: { ease: 'power2.out' } });
        heroTl
          .to('[data-animate="hero-portrait"]', { autoAlpha: 1, scale: 1, y: 0, duration: 0.65 })
          .to('[data-animate="hero-eyebrow"]',  { autoAlpha: 1, y: 0, duration: 0.4 }, '-=0.35')
          .to('[data-animate="hero-heading"]',  { autoAlpha: 1, y: 0, duration: 0.5 }, '-=0.28')
          .to('[data-animate="hero-subhead"]',  { autoAlpha: 1, y: 0, duration: 0.4 }, '-=0.22')
          .to('[data-animate="hero-tag"]',      { autoAlpha: 1, x: 0, duration: 0.32, stagger: 0.07 }, '-=0.18');

        gsap.to('[data-animate="section-panel"]', {
          autoAlpha: 1,
          y: 0,
          duration: 0.55,
          ease: 'power2.out',
          stagger: 0.08,
          delay: 0.08,
        });

        gsap.to('[data-animate="project-card"]', {
          autoAlpha: 1,
          y: 0,
          duration: 0.55,
          ease: 'power2.out',
          stagger: 0.07,
          delay: 0.22,
        });

        gsap.to('[data-animate="metrics-strip"]', {
          autoAlpha: 1,
          y: 0,
          duration: 0.5,
          ease: 'power2.out',
          delay: 0.42,
        });

        gsap.to('[data-animate="metric-cell"]', {
          autoAlpha: 1,
          y: 0,
          duration: 0.45,
          ease: 'power2.out',
          stagger: 0.06,
          delay: 0.5,
        });

        gsap.from('.microchart span', {
          scaleY: 0.15,
          transformOrigin: 'bottom center',
          duration: 0.6,
          ease: 'power2.out',
          stagger: 0.035,
          delay: 0.65,
        });
      }
    </script>
  </body>
</html>

<style>
  .hero-frame {
    padding: 1rem 1rem 0.75rem;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(320px, 0.65fr);
    gap: clamp(1rem, 2vw, 1.5rem);
    padding: clamp(1.35rem, 2.5vw, 2rem) 0 clamp(1rem, 2vw, 1.5rem);
    align-items: start;
  }

  .content-stack {
    display: grid;
    gap: 1rem;
    padding-top: 1rem;
  }

  .section-panel {
    display: grid;
    gap: 0.75rem;
    padding: 1rem;
    border-radius: var(--radius-md);
  }

  .mini-preview-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .mini-preview-card {
    display: grid;
    gap: 0.4rem;
    min-height: 100%;
    padding: 0.85rem;
    border: var(--border-dashed);
    background: var(--panel-overlay-soft);
  }

  .mini-preview-card strong {
    color: var(--accent);
    font-size: var(--text-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .mini-preview-card span {
    color: var(--foreground-soft);
    font-size: var(--text-sm);
    line-height: 1.55;
  }

  .mini-preview-link {
    transition: border-color 160ms ease, background 160ms ease, box-shadow 160ms ease;
  }

  .mini-preview-link:hover,
  .mini-preview-link:focus-visible {
    border-color: var(--accent);
    background: var(--accent-soft);
    box-shadow: var(--shadow-glow);
  }

  #work {
    display: grid;
    gap: 1rem;
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
    align-items: stretch;
  }

  @media (max-width: 1180px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }

    .project-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .mini-preview-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 720px) {
    .page-shell {
      width: min(100%, calc(100% - 1rem));
      padding-top: 0.5rem;
    }

    .hero-frame {
      padding: 0.75rem;
    }

    .project-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

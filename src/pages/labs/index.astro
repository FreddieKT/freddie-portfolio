---
import PageLayout from '../../layouts/PageLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { projects } from '../../data/projects';
---

<PageLayout title="Labs" description="Tools, experiments, and projects I've built.">
  <section class="editorial-section" data-animate="page-section">
    <span class="label">Labs</span>
    <div class="section-content">
      <p class="copy">Projects and experiments — tools I've built, things I've shipped, and stuff I'm still tinkering with.</p>
      <ul class="project-list" aria-label="Projects" style="margin-top:1.5rem">
        {projects.map((p) => <ProjectCard project={p} />)}
      </ul>
    </div>
  </section>
</PageLayout>

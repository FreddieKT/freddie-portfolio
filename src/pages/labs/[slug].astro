---
import PageLayout from '../../layouts/PageLayout.astro';
import { projects, type Project } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

interface Props { project: Project; }

const { project } = Astro.props;
const idx = projects.findIndex((p) => p.slug === project.slug);
const prev = projects[(idx - 1 + projects.length) % projects.length];
const next = projects[(idx + 1) % projects.length];
---

<PageLayout title={project.title} description={project.summary}>
  <section class="editorial-section" data-animate="page-section">
    <span class="label">Lab</span>
    <div class="section-content">
      <h1 class="lab-title">{project.title}</h1>
      <p class="lab-meta">{project.category} · {project.label} · {project.date} · {project.publisher}</p>
      <div class="lab-copy">
        <h2>Summary</h2>
        <p>{project.summary}</p>
        <h2>Problem</h2>
        <p>{project.problem}</p>
        <h2>What it does</h2>
        <p>{project.does}</p>
        <h2>Stack</h2>
        <ul>{project.stack.map((s) => (<li>{s}</li>))}</ul>
        <h2>Status</h2>
        <p>{project.status}</p>
        <h2>Next step</h2>
        <p>{project.nextStep}</p>
      </div>
    </div>
  </section>

  <nav class="lab-nav" data-animate="page-section">
    <a class="nav-pill" href={`/labs/${prev.slug}`}>← {prev.title}</a>
    <a class="nav-pill" href={`/labs/${next.slug}`}>{next.title} →</a>
  </nav>
</PageLayout>

<style>
  .lab-title {
    font-weight: 700;
    font-size: clamp(2rem, 4vw, 3.2rem);
    letter-spacing: -0.015em;
    line-height: 1;
    margin: 0 0 0.4rem;
  }
  .lab-meta { font-size: 0.8125rem; color: var(--ink-dim); letter-spacing: 0.05em; margin-bottom: 2rem; text-transform: uppercase; }
  .lab-copy { font-size: 0.9375rem; color: var(--ink-soft); line-height: 1.6; }
  .lab-copy h2 { font-size: 1.1rem; margin: 2rem 0 0.75rem; color: var(--ink); padding-bottom: 0.25rem; border-bottom: 1px solid var(--rule-soft); }
  .lab-copy p { margin: 0 0 1rem; }
  .lab-copy ul { padding-left: 1.5rem; }
  .lab-copy li { margin-bottom: 0.5rem; }
  .lab-copy li::marker { color: var(--accent); }
  .lab-nav {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.5rem 0 1.5rem;
  }
  .nav-pill {
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    color: var(--ink-dim);
    padding: 0.5rem 0.75rem;
  }
  .nav-pill:hover { color: var(--accent); }
</style>

---
import PageLayout from '../../layouts/PageLayout.astro';
import PageSidebar from '../../components/PageSidebar.astro';
import SectionLabel from '../../components/SectionLabel.astro';
import { projects, type Project } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
const idx = projects.findIndex((p) => p.slug === project.slug);
const prev = projects[(idx - 1 + projects.length) % projects.length];
const next = projects[(idx + 1) % projects.length];

const sidebarItems = projects.map((p) => ({
  label: p.title,
  href: `/labs/${p.slug}`,
}));
---

<PageLayout title={project.title} description={project.summary}>
  <PageSidebar
    slot="sidebar"
    heading="LABS"
    items={sidebarItems}
    activeHref={`/labs/${project.slug}`}
  />

  <article class="labs-detail">
    <div class="page-section frame combined-panel" data-animate="page-section">
      <div class="markdown-prose">
        <h1>{project.title}</h1>
        <p class="meta"><strong>{project.category}</strong> &middot; {project.label}</p>

        <h2>Summary</h2>
        <p>{project.summary}</p>

        <h2>Details</h2>
        <ul>
          {project.output.map((line) => (
            <li>{line}</li>
          ))}
        </ul>
      </div>
    </div>

    <nav class="page-section frame project-nav" aria-label="Project navigation" data-animate="page-section">
      <a class="nav-pill" href={`/labs/${prev.slug}`}>← {prev.title}</a>
      <a class="nav-pill" href={`/labs/${next.slug}`}>{next.title} →</a>
    </nav>
  </article>
</PageLayout>

<style>
  .labs-detail {
    display: grid;
    gap: 1rem;
  }

  .page-section {
    padding: 1.25rem;
    border-radius: var(--radius-md);
  }

  .combined-panel {
    background: var(--panel-overlay);
  }

  .markdown-prose {
    font-family: var(--font-mono);
    color: var(--foreground-soft);
    line-height: 1.6;
  }

  .markdown-prose h1 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3rem);
    color: var(--foreground);
    margin: 0 0 0.5rem 0;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  .markdown-prose h2 {
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--foreground);
    margin: 2rem 0 0.75rem 0;
    padding-bottom: 0.25rem;
    border-bottom: var(--border-dashed);
    text-transform: uppercase;
  }

  .markdown-prose p {
    margin: 0 0 1rem 0;
  }

  .markdown-prose .meta {
    font-size: var(--text-sm);
    color: var(--muted);
    margin-bottom: 2rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .markdown-prose ul {
    margin: 0;
    padding-left: 1.5rem;
  }

  .markdown-prose li {
    margin-bottom: 0.5rem;
  }

  .markdown-prose li::marker {
    color: var(--accent);
  }

  .project-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }
</style>

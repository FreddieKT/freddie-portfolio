---
import SectionLabel from './SectionLabel.astro';
import type { Project } from '../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article class="project-card corner-frame" aria-labelledby={`project-${project.index}`} data-animate="project-card">
  <a href={`/labs/${project.slug}`} class="card-link" aria-label={`View ${project.title} detail`}></a>
  <div class="project-top">
    <div>
      <p class="project-index">{project.index}</p>
      <p class="mini-kicker">{project.label}</p>
    </div>
    <span class="project-arrow" aria-hidden="true">↗</span>
  </div>

  <div>
    <SectionLabel>{project.category}</SectionLabel>
    <h2 id={`project-${project.index}`}>{project.title}</h2>
    <p class="mono-copy project-summary">{project.summary}</p>
  </div>

  <div class="project-terminal" aria-label={`${project.title} prototype command`}>
    <div class="project-command">$ {project.command}</div>
    <ul>
      {project.output.map((row) => <li>{row}</li>)}
    </ul>
  </div>

  {project.metrics && project.metrics.length > 0 && (
    <div class="metric-row" aria-label="Prototype indicators">
      {project.metrics.map((metric) => (
        <div>
          <span>{metric.name}</span>
          <strong>{metric.value}</strong>
        </div>
      ))}
    </div>
  )}
</article>

<style>
  .project-card {
    display: grid;
    gap: 1rem;
    padding: 1rem;
    border-radius: var(--radius-md);
    min-height: 100%;
    background: var(--panel-overlay);
    border: var(--border-solid);
    position: relative;
  }

  .card-link {
    position: absolute;
    inset: 0;
    z-index: 10;
    border-radius: var(--radius-md);
  }

  .project-card:has(.card-link:hover) {
    border-color: var(--accent);
    box-shadow: var(--shadow-glow);
  }

  .project-card:has(.card-link:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .project-top {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 1rem;
  }

  .project-index {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    color: var(--foreground);
  }

  .project-arrow {
    color: var(--accent);
    font-size: 1.1rem;
  }

  h2 {
    margin: 0.35rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 1.8vw, 1.7rem);
    line-height: 1.05;
    text-transform: uppercase;
  }

  .project-summary {
    margin-top: 0.9rem;
  }

  .project-terminal {
    display: grid;
    gap: 0.55rem;
    padding: 0.85rem;
    border: var(--border-dashed);
    background: var(--terminal-overlay);
    font-size: var(--text-sm);
  }

  .project-command {
    color: var(--accent);
    font-family: var(--font-mono);
  }

  .project-terminal ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.35rem;
  }

  .project-terminal li::before {
    content: '✓';
    margin-right: 0.45rem;
    color: var(--success);
  }

  .metric-row {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.6rem;
    padding-top: 0.25rem;
    border-top: var(--border-solid);
  }

  .metric-row span {
    color: var(--muted);
    font-size: var(--text-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .metric-row strong {
    display: block;
    margin-top: 0.25rem;
    color: var(--accent);
    font-family: var(--font-display);
    font-size: var(--text-md);
  }
</style>

---
import type { Project } from '../data/projects';

interface Props { project: Project; }
const { project } = Astro.props;

const shortStatus = (s: string) => {
  if (!s) return '\u2014';
  if (s.includes('live') || s.includes('LIVE')) return '\u25CF LIVE';
  if (s.includes('shipping') || s.includes('SHIPPING')) return 'SHIPPING';
  if (s.includes('building') || s.includes('BUILDING')) return 'BUILDING';
  if (s.includes('development')) return 'BUILDING';
  if (s.includes('lab')) return 'LAB';
  if (s.includes('ready') || s.includes('production')) return 'SHIPPING';
  return s.slice(0, 8).toUpperCase();
};
---

<li class="prow">
  <a href={`/labs/${project.slug}`} class="prow-link" aria-label={`View ${project.title}`}>
    <span class="prow-num">{project.index}</span>
    <span class="prow-body">
      <span class="prow-title">{project.title}</span>
      <span class="prow-label">{project.label} · {project.category} · {project.stack.slice(0, 2).join(' / ')}</span>
    </span>
    <span class="prow-state">{shortStatus(project.status)}</span>
      </a>
    </li>

<style>
  .prow {
    list-style: none;
    border-bottom: 1px solid var(--rule-soft);
  }
  .prow:first-child { border-top: 1px solid var(--rule-soft); }
  .prow:last-child { border-bottom: none; }
  .prow-link {
    display: grid;
    grid-template-columns: 2.5rem 1fr auto;
    align-items: center;
    gap: 1rem;
    padding: 1.4rem 0.5rem;
    color: inherit;
    text-decoration: none;
    transition: background 140ms ease;
  }
  .prow-link:hover { background: var(--accent-soft); }
  .prow-link:focus-visible { outline-offset: -2px; }
  .prow-num {
    font-size: 0.8125rem;
    color: var(--ink-faint);
    letter-spacing: 0.1em;
  }
  .prow-body {
    display: grid;
    gap: 0.3rem;
    min-width: 0;
  }
  .prow-title {
    font-size: 1.35rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }
  .prow-label {
    font-size: 0.8125rem;
    color: var(--ink-dim);
    letter-spacing: 0.04em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .prow-state {
    font-size: 0.625rem;
    letter-spacing: 0.12em;
    color: var(--ink-faint);
    white-space: nowrap;
  }
  @media (max-width: 600px) {
    .prow-state { display: none; }
    .prow-title { font-size: 1.1rem; }
  }
</style>

---
interface Props {
  label?: string;
}

const { label = 'now playing' } = Astro.props;
const bars = [0.48, 0.88, 0.62, 1, 0.42, 0.76, 0.56, 0.92, 0.5];
---

<button class="music-notch" type="button" aria-label="Decorative music mode indicator">
  <span class="music-notch__status" aria-hidden="true"></span>
  <span class="music-notch__label">{label}</span>
  <span class="music-notch__wave" aria-hidden="true">
    {bars.map((scale, index) => (
      <span style={`--scale: ${scale}; --delay: ${index * -0.11}s`}></span>
    ))}
  </span>
</button>

<style>
  .music-notch {
    --notch-glow: rgba(255, 73, 182, 0.28);
    position: relative;
    display: inline-flex;
    align-items: center;
    width: fit-content;
    min-height: 1.6rem;
    gap: 0.58rem;
    padding: 0;
    border: 0;
    border-radius: 0;
    color: var(--foreground-soft);
    background: transparent;
    box-shadow: none;
    font: inherit;
    font-family: var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    transition: transform 180ms ease, filter 180ms ease;
  }

  .music-notch:hover,
  .music-notch:focus-visible {
    transform: translateY(-1px);
    filter: drop-shadow(0 0 0.7rem rgba(116, 221, 255, 0.35));
  }

  .music-notch:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .music-notch__status {
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 999px;
    background: #30f2a2;
    box-shadow:
      0 0 0.45rem rgba(48, 242, 162, 0.9),
      0 0 1rem rgba(95, 232, 255, 0.35);
    animation: music-ping 1.8s ease-in-out infinite;
  }

  .music-notch__label {
    font-size: var(--text-xs);
    color: var(--muted);
    white-space: nowrap;
  }

  .music-notch__wave {
    display: inline-flex;
    align-items: center;
    height: 1rem;
    gap: 0.16rem;
  }

  .music-notch__wave span {
    display: block;
    width: 0.2rem;
    height: calc(0.86rem * var(--scale));
    min-height: 0.22rem;
    border-radius: 999px;
    background: linear-gradient(
      180deg,
      #ffffff 0%,
      #78f7ff 24%,
      #6d7cff 48%,
      #ff4fd8 72%,
      #ffb84d 100%
    );
    box-shadow:
      0 0 0.35rem rgba(120, 247, 255, 0.5),
      0 0 0.7rem rgba(255, 79, 216, 0.38),
      0 0 1rem rgba(255, 184, 77, 0.18);
    transform-origin: 50% 50%;
    animation: music-wave 0.86s ease-in-out infinite, music-hue 2.8s linear infinite;
    animation-delay: var(--delay), 0s;
  }

  :global(html[data-theme='light']) .music-notch {
    background: transparent;
  }

  @keyframes music-wave {
    0%, 100% {
      transform: scaleY(0.38);
      opacity: 0.55;
    }

    45% {
      transform: scaleY(1.22);
      opacity: 1;
    }
  }

  @keyframes music-ping {
    0%, 100% {
      opacity: 0.55;
      transform: scale(0.88);
    }

    50% {
      opacity: 1;
      transform: scale(1.08);
    }
  }

  @keyframes music-hue {
    0% {
      filter: hue-rotate(0deg) saturate(1.2);
    }

    50% {
      filter: hue-rotate(72deg) saturate(1.55);
    }

    100% {
      filter: hue-rotate(0deg) saturate(1.2);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .music-notch,
    .music-notch__status,
    .music-notch__wave span {
      animation: none;
      transition: none;
    }
  }
</style>

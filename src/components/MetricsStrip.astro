---
import SectionLabel from './SectionLabel.astro';
import { metricSignals } from '../data/metrics';
---

<section id="dashboard-stats" class="metrics-strip frame" aria-labelledby="systems-title" data-animate="metrics-strip">
  <div class="systems-copy metric-cell">
    <SectionLabel id="systems-title">Systems &gt; silos</SectionLabel>
    <h2>Building composable tools that remember, reason, and improve.</h2>
    <p class="mono-copy prototype-note">Prototype indicators only — no fake live stats.</p>
  </div>

  {metricSignals.map((metric) => (
    <div class="metric-cell signal-cell corner-frame" data-animate="metric-cell">
      <div class="metric-icon" aria-hidden="true">{metric.icon}</div>
      <p class="mini-kicker">{metric.label}</p>
      <p class="stat-value">{metric.value}</p>
      <div class:list={['microchart', metric.chart]} aria-hidden="true">
        <span></span><span></span><span></span><span></span><span></span><span></span>
      </div>
    </div>
  ))}
</section>

<style>
  .metrics-strip {
    display: grid;
    grid-template-columns: minmax(240px, 1.45fr) repeat(4, minmax(0, 1fr));
    border: var(--border-dashed);
    border-radius: var(--radius-md);
    background: var(--panel-overlay);
    overflow: hidden;
  }

  .metric-cell {
    min-width: 0;
    padding: 1rem;
  }

  .metric-cell + .metric-cell {
    border-left: var(--border-dashed);
  }

  .systems-copy {
    display: grid;
    gap: 0.75rem;
    align-content: center;
  }

  .systems-copy h2 {
    margin: 0.15rem 0 0;
    max-width: 26ch;
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 1.7vw, 1.65rem);
    line-height: 1.05;
    text-transform: uppercase;
  }

  .prototype-note {
    color: var(--muted);
    font-size: var(--text-sm);
  }

  .signal-cell {
    display: grid;
    gap: 0.55rem;
    align-content: start;
  }

  .metric-icon {
    display: inline-grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border: var(--border-solid);
    color: var(--foreground);
    font-family: var(--font-display);
    font-size: var(--text-xs);
  }

  .signal-cell .mini-kicker {
    color: var(--muted);
    font-size: var(--text-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .microchart {
    display: flex;
    align-items: end;
    gap: 0.25rem;
    height: 2.2rem;
  }

  .microchart span {
    width: 0.35rem;
    border-radius: 999px 999px 0 0;
    background: linear-gradient(180deg, var(--accent-strong), var(--accent));
  }

  .microchart span:nth-child(1) { height: 45%; }
  .microchart span:nth-child(2) { height: 72%; }
  .microchart span:nth-child(3) { height: 55%; }
  .microchart span:nth-child(4) { height: 92%; }
  .microchart span:nth-child(5) { height: 60%; }
  .microchart span:nth-child(6) { height: 84%; }

  .microchart.line span {
    width: 0.5rem;
    height: 0.35rem;
    border-radius: 999px;
    transform: translateY(calc((6 - var(--i, 1)) * 0.15rem));
  }

  .microchart.line span:nth-child(1) { --i: 2; }
  .microchart.line span:nth-child(2) { --i: 5; }
  .microchart.line span:nth-child(3) { --i: 3; }
  .microchart.line span:nth-child(4) { --i: 6; }
  .microchart.line span:nth-child(5) { --i: 4; }
  .microchart.line span:nth-child(6) { --i: 5; }

  @media (max-width: 1100px) {
    .metrics-strip {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .systems-copy {
      grid-column: 1 / -1;
    }

    .metric-cell + .metric-cell {
      border-left: 0;
      border-top: var(--border-dashed);
    }

    .signal-cell:nth-child(odd) {
      border-left: var(--border-dashed);
    }
  }

  @media (max-width: 720px) {
    .metrics-strip {
      grid-template-columns: 1fr;
    }

    .signal-cell:nth-child(odd) {
      border-left: 0;
    }
  }
</style>

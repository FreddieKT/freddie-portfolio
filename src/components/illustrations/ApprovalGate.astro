---
// Terminal-style approval gate (guardrail) illustration
---

<svg class="terminal-illu" viewBox="0 0 320 120" fill="none" xmlns="http://www.w3.org/2000/svg">
  <!-- Left side: incoming arrow + document -->
  <path d="M10 55 L40 55" stroke="var(--muted)" stroke-width="2"/>
  <path d="M36 49 L44 55 L36 61" stroke="var(--muted)" stroke-width="2"/>

  <rect x="44" y="42" width="20" height="26" rx="2"
        stroke="var(--foreground-soft)" stroke-width="1.5"
        fill="var(--surface)"/>

  <!-- Gate / barrier -->
  <rect x="80" y="28" width="12" height="56" rx="3"
        stroke="var(--accent)" stroke-width="2.5"
        fill="var(--accent-soft)"/>
  <!-- Gate stripes -->
  <line x1="80" y1="38" x2="92" y2="38" stroke="var(--accent)" stroke-width="4"/>
  <line x1="80" y1="48" x2="92" y2="48" stroke="var(--accent)" stroke-width="4"/>
  <line x1="80" y1="58" x2="92" y2="58" stroke="var(--accent)" stroke-width="4"/>
  <line x1="80" y1="68" x2="92" y2="68" stroke="var(--accent)" stroke-width="4"/>

  <!-- Gate arm -->
  <rect x="92" y="50" width="50" height="6" rx="2"
        stroke="var(--accent-strong)" stroke-width="2"
        fill="var(--accent-soft)"/>

  <!-- Checkmark / cross -->
  <text x="120" y="42" fill="var(--success)" font-size="20">✓</text>
  <text x="118" y="62" fill="#a34a3f" font-size="14" opacity="0.5">✗</text>

  <!-- Right side: output with person icon -->
  <path d="M148 55 L170 55" stroke="var(--muted)" stroke-width="2"/>
  <path d="M166 49 L174 55 L166 61" stroke="var(--muted)" stroke-width="2"/>

  <!-- Human icon -->
  <circle cx="190" cy="40" r="8" stroke="var(--foreground)" stroke-width="2" fill="none"/>
  <path d="M182 58 Q190 48 198 58" stroke="var(--foreground)" stroke-width="2" fill="none"/>
  <line x1="190" y1="48" x2="190" y2="56" stroke="var(--foreground)" stroke-width="2"/>

  <!-- Approved stamp -->
  <rect x="174" y="78" width="44" height="16" rx="2"
        stroke="var(--success)" stroke-width="1.5"
        fill="var(--success-soft)"/>
  <text x="196" y="89" fill="var(--success)" font-size="7"
        font-family="var(--font-mono)" text-anchor="middle"
        letter-spacing="0.08em">APPROVED</text>

  <!-- Label -->
  <text x="110" y="112" fill="var(--muted)" font-size="9"
        font-family="var(--font-mono)" text-anchor="middle"
        letter-spacing="0.12em">APPROVAL GATE</text>
</svg>

<style>
  .terminal-illu {
    width: 100%;
    max-width: 280px;
    height: auto;
    margin: 1.5rem auto;
    display: block;
  }
</style>
---
// Terminal-style full pipeline map illustration
---

<svg class="terminal-illu" viewBox="0 0 480 120" fill="none" xmlns="http://www.w3.org/2000/svg">
  <!-- Train track line -->
  <line x1="20" y1="58" x2="460" y2="58" stroke="var(--border-dashed-color)" stroke-width="2"
        stroke-dasharray="6 4"/>

  <!-- Station 1: Trigger -->
  <rect x="30" y="36" width="56" height="44" rx="4"
        stroke="var(--accent)" stroke-width="2"
        fill="var(--accent-soft)"/>
  <text x="58" y="62" fill="var(--accent)" font-size="7"
        font-family="var(--font-mono)" text-anchor="middle"
        letter-spacing="0.08em">TRIGGER</text>
  <text x="58" y="74" fill="var(--muted-faint)" font-size="6"
        font-family="var(--font-mono)" text-anchor="middle">📩</text>

  <!-- Station 2: Data -->
  <rect x="116" y="36" width="56" height="44" rx="4"
        stroke="var(--foreground)" stroke-width="2"
        fill="var(--surface)"/>
  <text x="144" y="62" fill="var(--foreground)" font-size="7"
        font-family="var(--font-mono)" text-anchor="middle"
        letter-spacing="0.08em">DATA</text>
  <text x="144" y="74" fill="var(--muted-faint)" font-size="6"
        font-family="var(--font-mono)" text-anchor="middle">📄</text>

  <!-- Station 3: AI -->
  <rect x="202" y="36" width="56" height="44" rx="4"
        stroke="var(--accent)" stroke-width="2"
        fill="var(--accent-soft)"/>
  <text x="230" y="62" fill="var(--accent)" font-size="7"
        font-family="var(--font-mono)" text-anchor="middle"
        letter-spacing="0.08em">AI</text>
  <text x="230" y="74" fill="var(--muted-faint)" font-size="6"
        font-family="var(--font-mono)" text-anchor="middle">🤖</text>

  <!-- Station 4: Approval -->
  <rect x="288" y="36" width="56" height="44" rx="4"
        stroke="var(--success)" stroke-width="2"
        fill="var(--success-soft)"/>
  <text x="316" y="62" fill="var(--success)" font-size="7"
        font-family="var(--font-mono)" text-anchor="middle"
        letter-spacing="0.08em">APPROVE</text>
  <text x="316" y="74" fill="var(--muted-faint)" font-size="6"
        font-family="var(--font-mono)" text-anchor="middle">🛂</text>

  <!-- Station 5: Output -->
  <rect x="374" y="36" width="56" height="44" rx="4"
        stroke="var(--foreground)" stroke-width="2"
        fill="var(--surface)"/>
  <text x="402" y="62" fill="var(--foreground)" font-size="7"
        font-family="var(--font-mono)" text-anchor="middle"
        letter-spacing="0.08em">OUTPUT</text>
  <text x="402" y="74" fill="var(--muted-faint)" font-size="6"
        font-family="var(--font-mono)" text-anchor="middle">📤</text>

  <!-- Arrows between stations -->
  <path d="M86 58 L112 58" stroke="var(--muted)" stroke-width="1.5"/>
  <path d="M108 54 L114 58 L108 62" stroke="var(--muted)" stroke-width="1.5"/>

  <path d="M172 58 L198 58" stroke="var(--muted)" stroke-width="1.5"/>
  <path d="M194 54 L200 58 L194 62" stroke="var(--muted)" stroke-width="1.5"/>

  <path d="M258 58 L284 58" stroke="var(--muted)" stroke-width="1.5"/>
  <path d="M280 54 L286 58 L280 62" stroke="var(--muted)" stroke-width="1.5"/>

  <path d="M344 58 L370 58" stroke="var(--muted)" stroke-width="1.5"/>
  <path d="M366 54 L372 58 L366 62" stroke="var(--muted)" stroke-width="1.5"/>

  <!-- Guardrail arc on top -->
  <path d="M215 36 L250 20 L280 36" stroke="var(--success)" stroke-width="1.5" fill="none" opacity="0.6"/>
  <text x="250" y="16" fill="var(--success)" font-size="6"
        font-family="var(--font-mono)" text-anchor="middle"
        letter-spacing="0.06em" opacity="0.7">GUARDRAIL</text>

  <!-- Label -->
  <text x="240" y="110" fill="var(--muted)" font-size="8"
        font-family="var(--font-mono)" text-anchor="middle"
        letter-spacing="0.12em">AI WORKFLOW PIPELINE</text>
</svg>

<style>
  .terminal-illu {
    width: 100%;
    max-width: 400px;
    height: auto;
    margin: 1.5rem auto;
    display: block;
  }
</style>
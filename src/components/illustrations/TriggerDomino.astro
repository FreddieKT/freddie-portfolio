---
// Terminal-style domino trigger illustration
---

<svg class="terminal-illu" viewBox="0 0 320 110" fill="none" xmlns="http://www.w3.org/2000/svg">
  <!-- First domino (falling) -->
  <rect x="20" y="38" width="6" height="36" rx="2"
        transform="rotate(-65 23 56)"
        stroke="var(--accent)" stroke-width="2"
        fill="var(--accent-soft)"/>
  <!-- Impact lines -->
  <line x1="68" y1="32" x2="80" y2="28" stroke="var(--accent)" stroke-width="1.5" opacity="0.6"/>
  <line x1="68" y1="40" x2="80" y2="40" stroke="var(--accent)" stroke-width="1.5" opacity="0.6"/>
  <line x1="68" y1="48" x2="80" y2="52" stroke="var(--accent)" stroke-width="1.5" opacity="0.6"/>
  <!-- Arrow -->
  <path d="M88 40 L110 40" stroke="var(--muted)" stroke-width="2"/>
  <path d="M106 34 L114 40 L106 46" stroke="var(--muted)" stroke-width="2"/>
  <!-- Second domino (standing) -->
  <rect x="118" y="18" width="6" height="44" rx="2"
        stroke="var(--foreground)" stroke-width="2"
        fill="var(--surface)"/>
  <!-- Glow dot -->
  <circle cx="121" cy="16" r="3" fill="var(--success)" opacity="0.8"/>
  <!-- Webhook wave -->
  <path d="M145 30 Q155 20 165 30 Q175 40 185 30" stroke="var(--muted-faint)" stroke-width="1.5" fill="none" opacity="0.5"/>
  <!-- Label -->
  <text x="60" y="92" fill="var(--muted)" font-size="9"
        font-family="var(--font-mono)" text-anchor="middle"
        letter-spacing="0.12em">TRIGGER</text>
  <text x="60" y="103" fill="var(--muted-faint)" font-size="7"
        font-family="var(--font-mono)" text-anchor="middle"
        letter-spacing="0.08em">EVENT → WORKFLOW</text>
</svg>

<style>
  .terminal-illu {
    width: 100%;
    max-width: 300px;
    height: auto;
    margin: 1.5rem auto;
    display: block;
  }
</style>

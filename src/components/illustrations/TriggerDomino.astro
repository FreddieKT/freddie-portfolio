---
// Terminal-native geometric illustration: TriggerDomino + DataFunnel merged
// Flow: TRIGGER (event source) → DATA (documents → funnel) → AI (processing → output)
---

<svg class="terminal-illu" viewBox="0 0 320 110" fill="none" xmlns="http://www.w3.org/2000/svg">

  <!-- ============================================================ -->
  <!-- OVERALL BRACKET FRAME                                        -->
  <!-- ============================================================ -->
  <path d="M8 6 L5 6 L5 106 L8 106" stroke="var(--border-strong)" stroke-width="1.5"/>
  <path d="M312 6 L315 6 L315 106 L312 106" stroke="var(--border-strong)" stroke-width="1.5"/>
  <line x1="8" y1="6" x2="312" y2="6" stroke="var(--grid-line-strong)" stroke-width="0.5"/>
  <line x1="8" y1="106" x2="312" y2="106" stroke="var(--grid-line-strong)" stroke-width="0.5"/>

  <!-- ============================================================ -->
  <!-- FLOW LABEL                                                   -->
  <!-- ============================================================ -->
  <text x="160" y="7" fill="var(--muted-faint)" font-size="5.5"
        font-family="var(--font-mono)" text-anchor="middle"
        letter-spacing="0.08em" dominant-baseline="hanging"
        opacity="0.5">TRIGGER → DATA → AI</text>

  <!-- ============================================================ -->
  <!-- SECTION 1: TRIGGER (x: 12–102)                               -->
  <!-- ============================================================ -->

  <!-- Section bracket  [  -->
  <path d="M14 20 L12 20 L12 76 L14 76" stroke="var(--border-strong)" stroke-width="1" opacity="0.4"/>
  <path d="M100 20 L102 20 L102 76 L100 76" stroke="var(--border-strong)" stroke-width="1" opacity="0.4"/>

  <!-- Event source: concentric geometric rings -->
  <circle cx="46" cy="44" r="18" stroke="var(--muted-faint)" stroke-width="0.8"
          fill="none" opacity="0.3"/>
  <circle cx="46" cy="44" r="12" stroke="var(--muted-faint)" stroke-width="1"
          fill="none" opacity="0.45"/>

  <!-- Event core: geometric diamond -->
  <polygon points="46,31 55,44 46,57 37,44"
           stroke="var(--accent)" stroke-width="1.8"
           fill="var(--accent-soft)"/>

  <!-- Radiating impact lines -->
  <line x1="46" y1="22" x2="46" y2="15" stroke="var(--muted-faint)" stroke-width="1" opacity="0.4"/>
  <line x1="46" y1="66" x2="46" y2="73" stroke="var(--muted-faint)" stroke-width="1" opacity="0.4"/>
  <line x1="68" y1="44" x2="75" y2="44" stroke="var(--muted-faint)" stroke-width="1" opacity="0.4"/>
  <line x1="24" y1="44" x2="17" y2="44" stroke="var(--muted-faint)" stroke-width="1" opacity="0.4"/>

  <!-- Webhook signal wave emanating right -->
  <path d="M68 38 Q76 28 84 38 Q92 48 100 38"
        stroke="var(--muted-faint)" stroke-width="1.2" fill="none" opacity="0.45"/>
  <circle cx="100" cy="38" r="2.5" fill="var(--success)" opacity="0.75"/>

  <!-- Label group -->
  <text x="46" y="84" fill="var(--muted)" font-size="7"
        font-family="var(--font-mono)" text-anchor="middle"
        letter-spacing="0.14em">TRIGGER</text>
  <text x="46" y="96" fill="var(--muted-faint)" font-size="5.5"
        font-family="var(--font-mono)" text-anchor="middle"
        letter-spacing="0.08em">EVENT</text>

  <!-- ============================================================ -->
  <!-- ARROW 1: TRIGGER → DATA                                     -->
  <!-- ============================================================ -->
  <line x1="104" y1="44" x2="124" y2="44" stroke="var(--muted)" stroke-width="1.5"/>
  <polygon points="124,40 130,44 124,48" fill="var(--muted)"/>

  <!-- ============================================================ -->
  <!-- SECTION 2: DATA FUNNEL (x: 132–208)                          -->
  <!-- ============================================================ -->

  <!-- Document 1 (tilted left) -->
  <rect x="132" y="16" width="16" height="20" rx="1.5"
        stroke="var(--muted-faint)" stroke-width="1.3"
        fill="var(--surface)" transform="rotate(-8 140 26)"/>
  <line x1="136" y1="22" x2="144" y2="22" stroke="var(--muted)" stroke-width="0.8"
        transform="rotate(-8 140 26)"/>
  <line x1="136" y1="26" x2="144" y2="26" stroke="var(--muted)" stroke-width="0.8"
        transform="rotate(-8 140 26)"/>

  <!-- Document 2 (center, accented) -->
  <rect x="154" y="12" width="16" height="20" rx="1.5"
        stroke="var(--accent)" stroke-width="1.3"
        fill="var(--accent-soft)" transform="rotate(3 162 22)"/>
  <line x1="158" y1="18" x2="166" y2="18" stroke="var(--accent)" stroke-width="0.8"
        transform="rotate(3 162 22)"/>
  <line x1="158" y1="22" x2="166" y2="22" stroke="var(--accent)" stroke-width="0.8"
        transform="rotate(3 162 22)"/>

  <!-- Document 3 (tilted right) -->
  <rect x="176" y="15" width="16" height="20" rx="1.5"
        stroke="var(--muted-faint)" stroke-width="1.3"
        fill="var(--surface)" transform="rotate(11 184 25)"/>
  <line x1="180" y1="21" x2="188" y2="21" stroke="var(--muted)" stroke-width="0.8"
        transform="rotate(11 184 25)"/>
  <line x1="180" y1="25" x2="188" y2="25" stroke="var(--muted)" stroke-width="0.8"
        transform="rotate(11 184 25)"/>

  <!-- Down-collection arrows -->
  <path d="M163 39 L163 46" stroke="var(--muted)" stroke-width="1.2"/>
  <polygon points="160,44 163,48 166,44" fill="var(--muted)"/>

  <!-- Funnel geometric shape -->
  <polygon points="132,48 206,48 179,78 159,78"
           stroke="var(--border-strong)" stroke-width="1.6"
           fill="var(--panel-overlay-soft)"/>

  <!-- Funnel internal divider lines -->
  <line x1="135" y1="56" x2="203" y2="56" stroke="var(--grid-line-strong)" stroke-width="0.8"/>
  <line x1="140" y1="64" x2="198" y2="64" stroke="var(--grid-line-strong)" stroke-width="0.8"/>
  <line x1="148" y1="72" x2="190" y2="72" stroke="var(--grid-line-strong)" stroke-width="0.8"/>

  <!-- Label group -->
  <text x="169" y="96" fill="var(--muted)" font-size="7"
        font-family="var(--font-mono)" text-anchor="middle"
        letter-spacing="0.14em">DATA</text>
  <text x="169" y="106" fill="var(--muted-faint)" font-size="5.5"
        font-family="var(--font-mono)" text-anchor="middle"
        letter-spacing="0.08em">FUNNEL</text>

  <!-- ============================================================ -->
  <!-- ARROW 2: DATA → AI                                          -->
  <!-- ============================================================ -->
  <line x1="210" y1="60" x2="228" y2="60" stroke="var(--muted)" stroke-width="1.5"/>
  <polygon points="228,56 234,60 228,64" fill="var(--muted)"/>

  <!-- ============================================================ -->
  <!-- SECTION 3: AI (x: 236–308)                                   -->
  <!-- ============================================================ -->

  <!-- Section bracket  ] -->
  <path d="M238 20 L236 20 L236 76 L238 76" stroke="var(--border-strong)" stroke-width="1" opacity="0.4"/>
  <path d="M306 20 L308 20 L308 76 L306 76" stroke="var(--border-strong)" stroke-width="1" opacity="0.4"/>

  <!-- AI processing node -->
  <rect x="238" y="38" width="42" height="24" rx="3"
        stroke="var(--accent)" stroke-width="2"
        fill="var(--accent-soft)"/>

  <!-- Internal activity indicators (LED-style dots) -->
  <circle cx="247" cy="50" r="2" fill="var(--success)" opacity="0.9"/>
  <circle cx="254" cy="50" r="2" fill="var(--success)" opacity="0.35"/>
  <circle cx="261" cy="50" r="2" fill="var(--success)" opacity="0.35"/>

  <!-- Processing bar inside AI box -->
  <line x1="247" y1="56" x2="274" y2="56" stroke="var(--accent)" stroke-width="1" opacity="0.5"/>

  <!-- Output arrow -->
  <line x1="280" y1="50" x2="290" y2="50" stroke="var(--accent)" stroke-width="1.5"/>

  <!-- Output result: small geometric document -->
  <rect x="292" y="40" width="15" height="18" rx="1.5"
        stroke="var(--accent)" stroke-width="1" fill="none" opacity="0.5"/>
  <line x1="296" y1="45" x2="303" y2="45" stroke="var(--muted)" stroke-width="0.7" opacity="0.4"/>
  <line x1="296" y1="49" x2="303" y2="49" stroke="var(--muted)" stroke-width="0.7" opacity="0.4"/>

  <!-- Label group -->
  <text x="260" y="84" fill="var(--accent)" font-size="7"
        font-family="var(--font-mono)" text-anchor="middle"
        letter-spacing="0.14em">AI</text>
  <text x="260" y="96" fill="var(--muted-faint)" font-size="5.5"
        font-family="var(--font-mono)" text-anchor="middle"
        letter-spacing="0.08em">PROCESS</text>

</svg>

<style>
  .terminal-illu {
    width: 100%;
    max-width: 320px;
    height: auto;
    margin: 1.5rem auto;
    display: block;
  }
</style>

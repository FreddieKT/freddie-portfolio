---
// Terminal-style AI helper illustration
---

<svg class="terminal-illu" viewBox="0 0 320 120" fill="none" xmlns="http://www.w3.org/2000/svg">
  <!-- Robot body -->
  <rect x="110" y="40" width="80" height="50" rx="6"
        stroke="var(--foreground)" stroke-width="2.5"
        fill="var(--surface)"/>

  <!-- Robot head -->
  <rect x="120" y="20" width="60" height="24" rx="10"
        stroke="var(--foreground)" stroke-width="2.5"
        fill="var(--surface)"/>

  <!-- Eyes -->
  <circle cx="140" cy="32" r="4" fill="var(--accent)"/>
  <circle cx="160" cy="32" r="4" fill="var(--accent)"/>
  <circle cx="140" cy="32" r="1.5" fill="var(--background)"/>
  <circle cx="160" cy="32" r="1.5" fill="var(--background)"/>

  <!-- Helper hat / cap -->
  <path d="M130 20 L150 6 L170 20 Z"
        stroke="var(--accent)" stroke-width="2"
        fill="var(--accent-soft)"/>

  <!-- Mouth (smile circuit) -->
  <path d="M138 40 Q150 46 162 40" stroke="var(--success)" stroke-width="1.5" fill="none"/>

  <!-- Arms -->
  <!-- Left arm holding pen -->
  <line x1="110" y1="55" x2="88" y2="45" stroke="var(--muted)" stroke-width="2"/>
  <line x1="88" y1="45" x2="80" y2="42" stroke="var(--muted)" stroke-width="2"/>
  <!-- Pen tip -->
  <path d="M76 40 L64 46" stroke="var(--accent)" stroke-width="1.5"/>

  <!-- Right arm -->
  <line x1="190" y1="55" x2="212" y2="50" stroke="var(--muted)" stroke-width="2"/>

  <!-- Tools on right -->
  <text x="218" y="48" fill="var(--muted)" font-size="14">📝</text>
  <text x="245" y="48" fill="var(--muted)" font-size="14">✂️</text>
  <text x="218" y="70" fill="var(--muted)" font-size="14">🏷️</text>

  <!-- Label -->
  <text x="150" y="108" fill="var(--muted)" font-size="9"
        font-family="var(--font-mono)" text-anchor="middle"
        letter-spacing="0.12em">HELPER</text>
  <text x="150" y="118" fill="var(--muted-faint)" font-size="7"
        font-family="var(--font-mono)" text-anchor="middle"
        letter-spacing="0.06em">NOT THE BOSS</text>
</svg>

<style>
  .terminal-illu {
    width: 100%;
    max-width: 280px;
    height: auto;
    margin: 1.5rem auto;
    display: block;
  }
</style>

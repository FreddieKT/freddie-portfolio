---
interface Props {
  name?: string;
  role?: string;
  status?: string;
}

const { name = 'Freddie', role = 'BUILDER @ KTT.DEV', status = 'BUILDING' } = Astro.props;

const cubitRows = [
  '0011100',
  '0111110',
  '1101011',
  '1111111',
  '1011101',
  '0010100',
  '0100010',
];
---

<section class="profile-card corner-frame" aria-labelledby="profile-title" data-animate="hero-status-card">
  <div class="profile-copy">
    <p class="mini-kicker">OPERATOR</p>
    <p class="profile-name" id="profile-title">{name}</p>
    <p class="mono-copy profile-role">{role}</p>
  </div>

  <div class="cubit-stage dashed-panel" aria-label="Pixel cubit mascot identity layer">
    <div class="cubit-grid" aria-hidden="true">
      {cubitRows.flatMap((row, rowIndex) =>
        [...row].map((cell, columnIndex) => (
          <i
            class:list={['cubit-cell', cell === '1' && 'is-filled', (rowIndex === 2 && (columnIndex === 2 || columnIndex === 4)) && 'is-eye']}
          />
        ))
      )}
    </div>
    <div class="cubit-copy">
      <p class="mini-kicker">PIXEL STAGE</p>
      <p class="cubit-title">CUBIT MODE</p>
      <p class="mono-copy cubit-note">playful block avatar layer / secondary identity</p>
    </div>
  </div>

  <div class="status-card dashed-panel">
    <p class="mini-kicker">STATUS</p>
    <div class="status-line">
      <span class="status-dot" aria-hidden="true"></span>
      <strong>{status}</strong>
    </div>
  </div>
</section>

<style>
  .profile-card {
    display: grid;
    gap: 0.95rem;
    padding: 1rem;
    border-radius: var(--radius-md);
    background: var(--panel-overlay);
    border: var(--border-solid);
  }

  .profile-copy {
    display: grid;
    gap: 0.45rem;
  }

  .profile-name {
    margin: 0;
    color: var(--accent);
    font-size: clamp(1.6rem, 3vw, 2.35rem);
    line-height: 0.95;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .profile-role {
    font-size: var(--text-sm);
    color: var(--muted);
  }

  .cubit-stage {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 0.85rem;
    padding: 0.85rem;
    background:
      radial-gradient(circle at 18% 18%, color-mix(in srgb, var(--accent) 22%, transparent), transparent 38%),
      var(--panel-overlay);
  }

  .cubit-grid {
    --cell: 0.42rem;
    display: grid;
    grid-template-columns: repeat(7, var(--cell));
    grid-auto-rows: var(--cell);
    gap: 0.12rem;
    padding: 0.45rem;
    border: var(--border-solid);
    border-radius: calc(var(--radius-md) - 0.35rem);
    background: var(--surface-terminal);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--accent) 18%, transparent);
  }

  .cubit-cell {
    width: var(--cell);
    height: var(--cell);
    background: transparent;
  }

  .cubit-cell.is-filled {
    background: var(--accent-soft);
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--foreground) 20%, transparent);
  }

  .cubit-cell.is-eye {
    background: var(--accent);
    box-shadow: 0 0 0 1px var(--foreground), 0 0 10px color-mix(in srgb, var(--accent) 55%, transparent);
  }

  .cubit-copy {
    min-width: 0;
    display: grid;
    gap: 0.28rem;
  }

  .cubit-title {
    margin: 0;
    color: var(--foreground);
    font-size: var(--text-sm);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .cubit-note {
    font-size: var(--text-xs);
    color: var(--muted);
  }

  .status-card {
    width: 100%;
    padding: 0.9rem 1rem;
    display: grid;
    gap: 0.35rem;
  }

  .status-line {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--foreground);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-size: var(--text-xs);
  }
</style>

---
const timestamp = 'UTC PROTOTYPE BUILD';
---

<footer id="contact" class="footer-bar frame">
  <div class="footer-identity">
    <p class="footer-brand">ktt.dev</p>
    <span aria-hidden="true">|</span>
    <p class="mono-copy footer-copy">builder of strange tools for real life</p>
  </div>

  <nav class="footer-links" aria-label="Social links">
    <span>find me on</span>
    <a href="https://github.com/FreddieKT" aria-label="GitHub profile" target="_blank" rel="noreferrer">GitHub</a>
    <a href="https://x.com/ktythaung" aria-label="X profile" target="_blank" rel="noreferrer">X</a>
    <a href="mailto:hello@ktt.dev">Email</a>
  </nav>

  <div class="footer-status">
  </div>
</footer>

<style>
  .footer-bar {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) auto minmax(0, 1fr);
    gap: 1rem;
    align-items: center;
    padding: 1rem;
    margin-top: 1rem;
    border-radius: var(--radius-md);
    background: var(--panel-overlay);
  }

  .footer-identity,
  .footer-links,
  .footer-status {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
  }

  .footer-brand {
    margin: 0;
    color: var(--accent);
    font-size: var(--text-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .footer-copy {
    font-size: var(--text-sm);
  }

  .footer-links,
  .footer-status {
    color: var(--muted);
    font-size: var(--text-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .footer-links {
    justify-content: center;
  }

  .footer-links a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    padding: 0 0.5rem;
    border-radius: var(--radius-sm);
  }

  .footer-links a:hover,
  .footer-links a:focus-visible {
    color: var(--accent);
    background: var(--interactive-overlay);
    outline: 1px dashed var(--accent);
    outline-offset: 2px;
  }

  .footer-status {
    justify-content: end;
    color: var(--success);
  }

  @media (max-width: 1100px) {
    .footer-bar {
      grid-template-columns: 1fr;
    }

    .footer-links,
    .footer-status {
      justify-content: start;
    }
  }

  @media (max-width: 720px) {
    .footer-identity,
    .footer-links,
    .footer-status {
      flex-wrap: wrap;
    }
  }
</style>

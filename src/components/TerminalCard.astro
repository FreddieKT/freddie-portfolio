---
interface TerminalLine {
  command: string;
  output: string;
}

interface Props {
  id?: string;
  titleId?: string;
  title?: string;
  path?: string;
  lines?: TerminalLine[];
  footerItems?: string[];
}

const {
  id = 'labs',
  titleId = 'terminal-title',
  title = 'TERMINAL',
  path = 'freddie@devbox:~',
  lines = [
    { command: 'afterglow --today', output: '↳ generating prototype digest…' },
    { command: 'unfog notes/', output: '✓ extracting decision shape' },
    { command: 'hermes skills doctor', output: '✓ local skill graph healthy' },
    { command: 'promptglass watch', output: '▋ observing prompt drift' },
  ],
  footerItems = ['PROTOTYPE OUTPUT', 'STATIC ASTRO', 'NO LIVE METRICS'],
} = Astro.props;
---

<section id={id} class="terminal-shell corner-frame" aria-labelledby={titleId}>
  <div class="terminal-head">
    <div class="terminal-head-left">
      <span class="status-dot" aria-hidden="true"></span>
      <span id={titleId}>{title}</span>
    </div>
    <span class="terminal-path">{path}</span>
  </div>

  <div class="terminal-body" aria-label="Prototype command output">
    {lines.map((line) => (
      <div class="terminal-row">
        <code>{`freddie.k$ ${line.command}`}</code>
        <span>{line.output}</span>
      </div>
    ))}
  </div>

  <div class="terminal-footer">
    {footerItems.map((item) => <span>{item}</span>)}
  </div>
</section>

<style>
  .terminal-shell {
    display: grid;
    gap: 1rem;
    padding: 1rem;
    border-radius: var(--radius-md);
    background: var(--panel-overlay);
    border: var(--border-solid);
  }

  .terminal-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: var(--border-solid);
    color: var(--muted);
    font-size: var(--text-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .terminal-head-left {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }

  .terminal-path,
  .terminal-row code {
    color: var(--accent);
  }

  .terminal-body {
    display: grid;
    gap: 0.65rem;
    font-size: var(--text-sm);
  }

  .terminal-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: baseline;
    color: var(--foreground-soft);
  }

  .terminal-row code {
    font-family: var(--font-mono);
  }

  .terminal-row span {
    color: var(--muted);
  }

  .terminal-footer {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding-top: 0.75rem;
    border-top: var(--border-solid);
    color: var(--muted);
    font-size: var(--text-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
</style>

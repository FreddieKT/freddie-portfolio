---
import ThemeToggle from './ThemeToggle.astro';

interface NavItem { label: string; href: string; }
interface Props { navItems?: NavItem[]; }

const { navItems = [
  { label: 'ABOUT', href: '/about' },
  { label: 'LABS',  href: '/labs' },
  { label: 'NOTES', href: '/notes' },
] } = Astro.props;
---

<header class="hd section-hairline" aria-label="Primary">
  <div class="brand-lockup">
    <a class="brand" href="/" aria-label="FREDDIE K. home">
      <span class="brand-name">FREDDIE K.</span>
      <span class="brand-path">~/home/freddie</span>
    </a>
    <ThemeToggle />
  </div>
  <nav class="nav" aria-label="Main navigation">
    {navItems.map((item) => (
      <a class="nav-link" href={item.href}>{item.label}</a>
    ))}
  </nav>
  <a class="contact-link" href="/contact">&gt; CONTACT</a>
</header>

<style>
  .hd {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding-bottom: 1.5rem;
    flex-wrap: wrap;
  }
  .brand-lockup {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .brand { display: grid; gap: 0.35rem; }
  .brand-name { font-size: 0.8125rem; font-weight: 600; letter-spacing: 0.14em; }
  .brand-path { font-size: 0.75rem; color: var(--ink-faint); letter-spacing: 0.04em; }
  .nav {
    display: flex;
    gap: 0.15rem;
    margin-left: auto;
  }
  .nav-link {
    padding: 0.55rem 0.75rem;
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    color: var(--ink-dim);
    border-radius: 4px;
    transition: color 140ms ease, background 140ms ease;
  }
  .nav-link:hover { color: var(--accent); background: var(--accent-soft); }
  .contact-link {
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    color: var(--accent);
    padding: 0.55rem 0.75rem;
    border: 1px solid var(--rule);
    border-radius: 4px;
    transition: border-color 140ms ease;
  }
  .contact-link:hover { border-color: var(--accent); }
  @media (max-width: 720px) {
    .hd { flex-direction: column; align-items: stretch; gap: 0.75rem; }
    .brand-lockup { justify-content: space-between; }
    .nav { margin-left: 0; flex-wrap: wrap; }
    .contact-link { text-align: center; }
  }
</style>

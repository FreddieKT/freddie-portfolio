---
import { Image } from 'astro:assets';
import profileAboutImage from '../assets/images/profile-about.jpg';

interface Props {
  eyebrow?: string;
  title?: string;
  subtitle?: string;
  categories?: string[];
}

const {
  eyebrow = 'personal site / ongoing experiments',
  title = "Hey, I'm Freddie.",
  subtitle = 'I build small tools, automate the boring stuff, and tinker with AI systems. This is where I keep the things that actually work.',
  categories = ['BUILDING', 'AUTOMATION', 'AI / AGENTS', 'OPEN SOURCE'],
} = Astro.props;
---

<section class="hero section-hairline" aria-labelledby="hero-title">
  <div class="hero-text">
    <span class="label">{eyebrow}</span>
    <h1 id="hero-title" class="hero-title">Hey, I'm <span class="accent">Freddie.</span></h1>
    <p class="copy hero-subtitle">{subtitle}</p>
    <div class="tags" aria-label="Categories">
      {categories.map((cat) => (<span class="tag">{cat}</span>))}
    </div>
  </div>
  <figure class="portrait">
    <Image
      src={profileAboutImage}
      alt="Freddie, the builder behind Freddie K."
      width={140}
      height={186}
      loading="eager"
      decoding="async"
    />
  </figure>
</section>

<style>
  .hero {
    display: flex;
    flex-direction: column-reverse;
    gap: 1.75rem;
    padding: 3rem 0 2.75rem;
  }
  .hero-text {
    display: grid;
    gap: 0.9rem;
    min-width: 0;
  }
  .hero-title {
    margin: 0;
    font-weight: 700;
    font-size: clamp(3rem, 7.5vw, 5.25rem);
    letter-spacing: -0.025em;
    line-height: 0.98;
  }
  .hero-title .accent { color: var(--accent); }
  .hero-subtitle { font-size: 1.05rem; max-width: 46ch; }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .tag {
    font-size: 0.625rem;
    letter-spacing: 0.12em;
    color: var(--ink-faint);
    padding: 0.25rem 0;
  }
  .portrait {
    flex: 0 0 auto;
    width: 7.5rem;
    margin: 0;
    border: none;
  }
  .portrait img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 4px;
  }
  @media (max-width: 720px) {
    .hero { padding: 2rem 0; gap: 1.25rem; }
    .hero-title { font-size: clamp(2rem, 10vw, 3.2rem); }
  }
</style>
